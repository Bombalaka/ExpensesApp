@{
    ViewData["Title"] = "Expense";
}

@model List<Expenses.Models.Expense>

<div class="text-center">
    <h1 class="display-4">Expenses</h1>
    <br />
    <hr />
    <br />
    <h3 class="display-5">Total expenses $@ViewBag.Expenses</h3>
    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Amount</th>
                <th>Description</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Id</td>
                    <td>@item.Amount</td>
                    <td>@item.Description</td>
                    <td>
                        <a asp-action="CreateEditExpenses" asp-route-id="@item.Id">Edit</a>
                        <a asp-action="DeleteExpense" asp-route-id="@item.Id">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
