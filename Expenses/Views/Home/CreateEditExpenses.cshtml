@{
    ViewData["Title"] = "Create/Edit";
}
@model Expenses.Models.Expense

<div class="text-center">
    <h1 class="display-4">Create/Edit or add the expenses</h1>
</div>

<form asp-action="CreateEditExpensesForm" asp-controller="Home">
    <label hidden class="mt-4"> Id </label>
    <input hidden class="form-control" type="number" placeholder="0" asp-for="Id" />

    <label class="mt-4"> Amount $ </label>
    <input class="form-control" type="number" placeholder="0" asp-for="Amount" step="0.01" />

    <label class="mt-4"> Description </label>
    <input class="form-control" type="text" placeholder="Add the description" asp-for="Description" />

    <button class="btn btn-primary mt-4" type="submit">OK</button>
</form>
